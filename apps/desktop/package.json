{
  "name": "@flatsix/desktop",
  "version": "0.1.8",
  "private": true,
  "main": "main.mjs",
  "description": "FLAT·SIX Desktop — full garage app + in-process OBD",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "bundle:host": "node scripts/bundle-host.mjs",
    "prestart": "node scripts/bundle-host.mjs && node scripts/build-icons.mjs",
    "start": "electron .",
    "dev": "node ./scripts/dev.mjs",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "prepack:artifacts": "node scripts/bundle-host.mjs && node scripts/prepare-standalone.mjs && node scripts/build-icons.mjs",
    "pack": "npm run bundle:host && npm run icons && electron-builder --win nsis portable --x64",
    "pack:mac": "npm run bundle:host && npm run icons && electron-builder --mac dmg zip --x64 --arm64",
    "pack:all": "npm run bundle:host && npm run icons && electron-builder --win nsis portable --x64 --mac dmg zip --x64 --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.flatsix.desktop",
    "productName": "FLAT·SIX",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "obd-host-runner.mjs",
      "mac-updater.mjs",
      "build/icon.png",
      "build/icon.icns",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "standalone",
        "to": "standalone",
        "filter": ["**/*"]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*"
    ],
    "afterPack": "./scripts/after-pack-sign.mjs",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FLAT·SIX",
      "artifactName": "FLAT-SIX-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FLAT-SIX-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "dmitry-grechko",
      "repo": "flat-six",
      "releaseType": "release"
    },
    "protocols": {
      "name": "FLAT·SIX",
      "schemes": ["flatsix"]
    }
  }
}
