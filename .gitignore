2015-porsche-boxster-gts-718/

# workshop manual PDF (~213 MB) + Free-tier compressed volumes — local only
public/manual/*.pdf
public/manual/volumes.json

# Mobile Tech Library (~3 GB, © Porsche) — keep local only; allow the README
public/mobile_tech_library/**
!public/mobile_tech_library/README.md

# workshop / MTL / parts extraction (© Porsche — never commit; feed your own Supabase only)
/data/manual-*.json
/data/mtl-*.json
/data/parts-*.json
/data/

# WM CAD page extracts used to calibrate 3D gen (© Porsche — local only)
/tools/gen/wm-refs/**/*.png
# allow workflow helpers / notes / traces / scripts under wm-refs
!/tools/gen/wm-refs/**/*.md
!/tools/gen/wm-refs/**/*.mjs
!/tools/gen/wm-refs/**/*.py
!/tools/gen/wm-refs/**/*.json
!/tools/gen/wm-refs/**/*.trace.json
